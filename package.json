{
    "name": "@darco2903/ffmpeg-ts",
    "version": "1.0.7",
    "author": "Darco2903",
    "description": "TypeScript FFMPEG CLI Wrapper",
    "keywords": [
        "ffmpeg",
        "typescript",
        "cli",
        "wrapper"
    ],
    "license": "MIT",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "packageManager": "pnpm@12.16.1",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=22"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Darco2903/ffmpeg-ts.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc",
        "check": "tsc --noEmit",
        "prepack": "pnpm build",
        "test": "vitest run",
        "clean": "rimraf -g dist darco2903-ffmpeg-ts-*.tgz"
    },
    "dependencies": {
        "@darco2903/typed-emitter": "^1.3.0",
        "neverthrow": "^8.2.0"
    },
    "devDependencies": {
        "@types/node": "^25.3.5",
        "rimraf": "^6.1.3",
        "typescript": "^5.9.3",
        "vitest": "^4.0.18"
    }
}
